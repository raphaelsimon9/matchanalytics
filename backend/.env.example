FOOTBALL_DATA_KEY=your_football_data_org_token
CORS_ORIGINS=http://localhost:5173,https://your-web-app.vercel.app
MAX_STAKE_PCT=0.02

# ---- odds providers: set any you like (all optional) ----
# 1) The Odds API (500 free credits/month)
ODDS_API_KEY=
# 2) API-Football (free: 100 requests/day; has Over 1.5 and BTTS odds)
API_FOOTBALL_KEY=
# 3) Odds-API.io (paid; includes SportyBet and Stake prices)
ODDSAPIIO_KEY=
ODDSAPIIO_BOOKMAKERS=SportyBet,Stake

# Compare against these bookmakers first (names are matched loosely)
PREFERRED_BOOKMAKERS=SportyBet,Stake,Football.com
# Refresh odds at most this often (seconds). 21600 = 6 hours
ODDS_CACHE_SECONDS=21600
# Lower credit use for The Odds API
THEODDSAPI_REGIONS=eu
THEODDSAPI_MARKETS=h2h,totals

# Deployment only: Postgres (Neon/Supabase). Leave unset locally to use SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DB_PATH=stat90.db
